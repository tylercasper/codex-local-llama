#!/usr/bin/env bash
set -euo pipefail

runtime_root="${CODEX_LOCAL_RUNTIME_ROOT:-${HOME:?}/.local/lib/codex-local}"
export CODEX_HOME="${CODEX_LOCAL_HOME:-${HOME}/.codex-local}"
unset OPENAI_API_KEY OPENAI_BASE_URL CODEX_OSS_BASE_URL CODEX_OSS_PORT

exec "$runtime_root/codex/current/bin/codex" --profile local "$@"
