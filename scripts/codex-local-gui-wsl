#!/usr/bin/python3
"""Adapt Windows filesystem paths sent by the GUI to its WSL app-server.

Install beside gui_backend.py and its binding, and select with CODEX_CLI_PATH.
The GUI's default-project creation currently sends Windows paths to Linux RPCs.
"""
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import threading

sys.path.insert(0, str(Path(__file__).resolve().parent))
from gui_backend import BINDING, backend_path, load_binding, sqlite_home


def linux_path(value):
    if not isinstance(value, str):
        return value
    drive = re.fullmatch(r'([A-Za-z]):[\\/](.*)', value, re.DOTALL)
    if drive:
        return f'/mnt/{drive[1].lower()}/' + drive[2].replace('\\', '/')
    unc = re.fullmatch(r'\\\\(?:wsl\$|wsl\.localhost)\\([^\\]+)(?:\\(.*))?', value,
                       re.IGNORECASE | re.DOTALL)
    if unc and unc[1].casefold() == os.environ.get('WSL_DISTRO_NAME', '').casefold():
        return '/' + (unc[2] or '').replace('\\', '/')
    return value


def translate(message):
    params = message.get('params')
    method = message.get('method', '')
    if not isinstance(params, dict):
        return message
    fields = ('path', 'sourcePath', 'destinationPath') if method.startswith('fs/') else ()
    if method in ('process/spawn', 'thread/start', 'thread/resume', 'thread/fork', 'turn/start'):
        fields = ('cwd',)
    for field in fields:
        if field in params:
            params[field] = linux_path(params[field])
    if method in ('thread/start', 'thread/resume', 'thread/fork', 'turn/start'):
        roots = params.get('runtimeWorkspaceRoots')
        if isinstance(roots, list):
            params['runtimeWorkspaceRoots'] = [linux_path(root) for root in roots]
    if method in ('project/create', 'project/update', 'project/import'):
        roots = params.get('roots')
        if isinstance(roots, list):
            for root in roots:
                if isinstance(root, dict) and 'path' in root:
                    root['path'] = linux_path(root['path'])
    return message


def main():
    try:
        if not os.environ.get('CODEX_HOME'):
            raise ValueError('CODEX_HOME must identify the private GUI profile')
        home = linux_path(os.environ['CODEX_HOME'])
        os.environ['CODEX_HOME'] = home
        os.environ['CODEX_SQLITE_HOME'] = str(sqlite_home(home))
        backend = str(backend_path(load_binding(Path(__file__).resolve().with_name(BINDING))))
    except (OSError, ValueError, KeyError) as error:
        raise SystemExit(f'Codex Local GUI backend: {error}')
    args = [backend, *sys.argv[1:]]
    if 'app-server' not in sys.argv[1:]:
        os.execv(backend, args)
    child = subprocess.Popen(args, stdin=subprocess.PIPE)

    def feed():
        try:
            for line in sys.stdin.buffer:
                try:
                    message = json.loads(line)
                    if isinstance(message, dict):
                        line = json.dumps(translate(message), ensure_ascii=False).encode() + b'\n'
                except (ValueError, UnicodeError):
                    pass
                child.stdin.write(line)
                child.stdin.flush()
        except BrokenPipeError:
            pass
        finally:
            try:
                child.stdin.close()
            except BrokenPipeError:
                pass

    threading.Thread(target=feed, daemon=True).start()
    raise SystemExit(child.wait())


if __name__ == '__main__':
    main()
