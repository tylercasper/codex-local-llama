[Unit]
Description=Codex Responses and standalone web-search adapter for llama.cpp
Requires=codex-local-tunnel.service
After=codex-local-tunnel.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@WORKING_DIRECTORY@
Environment=@UPSTREAM_ENV@
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=tavily_key:/etc/codex-local/tavily.key
ExecStart=@PROVIDER_EXEC@ --host @PROVIDER_HOST@ --port @PROVIDER_PORT@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
